{
  "id": "/app/",
  "name": "SkillWard",
  "short_name": "SkillWard",
  "description": "Healthcare workforce learning, competency and compliance.",
  "lang": "en-AU",
  "dir": "ltr",
  "start_url": "/app/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f5f8f8",
  "theme_color": "#112f3e",
  "categories": ["business", "education", "medical", "productivity"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "shortcuts": [
    { "name": "My work", "short_name": "Work", "url": "/app/?view=work", "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Training", "short_name": "Training", "url": "/app/?view=training", "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Guided Demo", "short_name": "Demo", "url": "/demo/", "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
